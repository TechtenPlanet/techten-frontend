rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all donations
    match /donations/{donationId} {
      allow read: if true;
      // Only allow write access from authenticated users or server
      allow write: if request.auth != null || request.resource.data.keys().hasAll(['paymentId', 'status']);
    }
    
    // Form submissions collection
    match /form_submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Volunteers collection
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Partnerships collection
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Contacts collection
    match /contacts/{contactId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
